{
  "name": "@alexpricedev/billet-storage",
  "version": "0.1.0",
  "description": "File storage for Billet apps: an S3 bucket in production, a local directory in development, one interface for both. Bun.",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "lint": "biome check .",
    "lint:write": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck",
    "check": "bun run lint && bun run typecheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT",
  "author": "Alex Price",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexpricedev/billet-storage.git"
  },
  "bugs": {
    "url": "https://github.com/alexpricedev/billet-storage/issues"
  },
  "homepage": "https://github.com/alexpricedev/billet-storage#readme",
  "keywords": [
    "storage",
    "s3",
    "uploads",
    "files",
    "billet",
    "bun"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "^5.9.0"
  }
}
